# ─── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=QuickShow

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=<long-random-secret-at-least-32-chars>

# ─── TMDB (The Movie Database) ────────────────────────────────────────────────
# Register at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=<your-tmdb-api-key>

# ─── Stripe Payments ─────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_<your-stripe-secret-key>

# ─── Inngest (event functions, optional) ─────────────────────────────────────
INNGEST_EVENT_KEY=<your-inngest-event-key>
INNGEST_SIGNING_KEY=<your-inngest-signing-key>

# ─── Redis Caching ────────────────────────────────────────────────────────────
# Local:  redis://localhost:6379
# Cloud:  redis://default:<password>@<host>:<port>
# If not set, the app falls back to direct DB queries (no caching)
REDIS_URL=redis://localhost:6379

# ─── RabbitMQ Message Queue ───────────────────────────────────────────────────
# Local:  amqp://localhost
# Cloud:  amqps://<user>:<password>@<host>/<vhost>
# If not set, booking still works but async notifications are disabled
RABBITMQ_URL=amqp://localhost

# ─── Google Maps Platform ─────────────────────────────────────────────────────
# Enable "Routes API" at: https://console.cloud.google.com/apis/library
# SECURITY: This key is server-side only. Never put it in the frontend.
# If not set, the transport feature uses a clearly-labeled dev fallback.
GOOGLE_MAPS_API_KEY=<your-google-maps-server-side-api-key>

# ─── Fare Estimation (configurable rates in INR) ──────────────────────────────
# Formula: estimatedFare = baseFare + (distanceKm × perKmRate)
# These are ESTIMATES; actual fares depend on the taxi/auto operator.
FARE_BASE_AUTO=25
FARE_PKM_AUTO=12
FARE_BASE_MINI=40
FARE_PKM_MINI=14
FARE_BASE_SEDAN=50
FARE_PKM_SEDAN=18

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
